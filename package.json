{
  "name": "steam-console-wiki-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "bunx tsc --noEmit && next lint",
    "format": "bunx biome format --write",
    "wiki:prepare": "node scripts/wiki-workflow.mjs prepare",
    "wiki:approve": "node scripts/wiki-workflow.mjs approve",
    "wiki:status": "node scripts/wiki-workflow.mjs status",
    "wiki:generate": "node scripts/wiki-workflow.mjs generate",
    "wiki:set-domain": "node scripts/wiki-workflow.mjs set-domain",
    "wiki:finalize": "node scripts/wiki-workflow.mjs finalize",
    "seoscout:setup": "bash scripts/setup-seoscout.sh",
    "seoscout:search": "cd seoscout && seoscout search --keywords keywords.json",
    "seoscout:collect": "cd seoscout && seoscout collect --keywords keywords.json",
    "seoscout:generate": "cd seoscout && seoscout generate --keywords keywords.json --prompt prompts/generate.md",
    "seoscout:translate": "cd seoscout && seoscout translate --keywords keywords.json",
    "seoscout:run": "cd seoscout && seoscout run --keywords keywords.json --prompt prompts/generate.md",
    "seoscout:sync": "bash scripts/seoscout-sync-content.sh"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "15.3.7",
    "@next/third-parties": "^15.3.7",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.3.7",
    "next-intl": "^4",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grab": "latest",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "same-runtime": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.41": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
